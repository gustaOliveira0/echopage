[Unit]
Description=echopage — clonador de páginas
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=echopage
Group=echopage
WorkingDirectory=/opt/echopage
EnvironmentFile=/etc/echopage.env
ExecStart=/usr/bin/python3 /opt/echopage/painel.py 7000
Restart=always
RestartSec=5

# O Chrome precisa de /tmp e de escrever no perfil; o resto fica trancado.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/echopage /var/lib/echopage
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# uma captura pesada come memória; sem teto ela derruba a VPS. Numa máquina
# de 2 GB o teto tem de caber na RAM: MemoryHigh freia e recupera antes, e o
# swap do instalador absorve o pico em vez de o kernel matar a captura.
MemoryHigh=1400M
MemoryMax=1800M
MemorySwapMax=4G
TasksMax=800

[Install]
WantedBy=multi-user.target
